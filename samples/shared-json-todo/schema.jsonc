// How this app's data is organised.
//
// This is a DRAFT to paste into the data's "Data structure description" in
// Settings > Data. Ato stores that text and shows it to anyone who can read
// the data; it does not parse it and never checks the data against it. If the
// two disagree, this file is what is wrong.
//
// Every value below is made up. Nothing here is real user content.
//
// One more thing worth saying out loud: the "revision" in this document is
// this app's own counter. Ato's Resource revision is a separate number used
// for conflict detection, and the two are unrelated — do not compare them.
{
  "schemaVersion": 1, // number. This app's shape version.
  "revision": 2, // number. This app's own counter, NOT Ato's Resource revision.
  "updatedAt": null, // ISO 8601 string or null. Often null; do not rely on it.
  "updatedBy": "example", // string or null. Free text; not an account id.

  // Ordered left to right by "order". A task's columnId points at one of these
  // ids. Boards may have different columns than the three below.
  "columns": [
    { "id": "todo", "title": "Todo", "order": 1000 },
    { "id": "progress", "title": "In Progress", "order": 2000 },
    { "id": "done", "title": "Done", "order": 3000 }
  ],

  // IMPORTANT: "tasks" is an OBJECT keyed by task id. It is not an array.
  // The key and the task's own "id" are the same value.
  "tasks": {
    "task-example": {
      "id": "task-example", // string. Stable. Never regenerate it.
      "title": "An example task", // string. May be empty.

      // string. May be empty or missing. Free text, can be long and
      // multi-line. It is task content, not a UI detail — keep it.
      "description": "Longer notes about the task.",

      // "low" | "medium" | "high" in practice. Treat an unknown value as
      // unknown rather than mapping it to something else.
      "priority": "medium",

      // "YYYY-MM-DD", or null when there is no due date.
      // DATE ONLY: no time and no timezone. Do not convert it to an instant —
      // that is how a date slips to the previous or next day for someone.
      "dueAt": "2026-09-20",

      // boolean. THE COMPLETION FLAG.
      //
      // It is INDEPENDENT of columnId and the two CAN disagree: a task can sit
      // in the "done" column with completed:false, or be completed while in
      // another column. They are only ever linked when a task is first
      // created. Do not "fix" one from the other — show what is there.
      "completed": false,

      // string. Which column the task sits in; references columns[].id.
      "columnId": "done",

      // number. Position within its column, ascending. Sparse on purpose
      // (1000, 2000, …) so a task can be inserted between two others.
      "order": 2000,

      // Array, possibly empty or missing. Ordered by "order" like tasks are.
      // These are task content too; a reader that ignores them must still
      // write them back untouched.
      "subtasks": [
        { "id": "sub-1", "title": "A step", "completed": true, "order": 1000 },
        { "id": "sub-2", "title": "Another", "completed": false, "order": 2000 }
      ],

      "createdAt": null, // ISO 8601 string or null. Often null.
      "updatedAt": null // ISO 8601 string or null. Often null.
    }
  }

  // UNKNOWN FIELDS
  //
  // A document may carry top-level keys and task fields that are not listed
  // here — written by a newer version of this app, or by a different app
  // entirely. Preserve them. Write by applying your change on top of the
  // document you just read; never rebuild it from the fields you know, or you
  // will silently delete someone else's data.
  //
  // MISSING AND NULL
  //
  // Treat a missing field and a null field the same way: unknown. Do not fill
  // in a default and save it back — that turns "not set" into "set", which the
  // other app cannot tell apart.
}
