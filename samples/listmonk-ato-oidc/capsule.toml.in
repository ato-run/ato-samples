schema = "ato.capsule/2"

[application]
title = "listmonk"
# listmonk's own entry point is the login page: OIDC is enabled in every
# Instance, and the page carries the one button that starts the Ato sign-in.
# It answers 200 without a listmonk session (a regular account has no password
# to type), so it is also a stable surface for the Runner.
surface_path = "/admin/login"

[[input]]
id = "workspace"
use = "ato.workspace@1"
path = "."

# Ato's OpenID Provider, reached through the Runner's issuer relay. Ato launches
# a single-step OCI route that declares this network Binding as a group of one
# service, so the application container receives the relay (ato-api a250f81c7
# or later, ato Runner 68de170 or later).
[[binding]]
id = "oidc_issuer"
protocol = "ato.oidc-issuer@1"
required = true

[[binding]]
id = "oidc_client_id"
protocol = "ato.secret@1"
required = true

[[binding]]
id = "oidc_client_secret"
protocol = "ato.secret@1"
required = true

# The password of listmonk's PostgreSQL user. The database runs in the same
# container and the same state as listmonk; start.sh re-applies it on every
# start, so a rotated binding takes effect without touching the datadir.
[[binding]]
id = "db_password"
protocol = "ato.secret@1"
required = true

# The password of listmonk's own administrator ("admin"). The account is made
# by the installation on first start and its hash is re-applied on every start.
# OIDC sign-in never creates an administrator.
[[binding]]
id = "admin_password"
protocol = "ato.secret@1"
required = true

# PostgreSQL's data directory and listmonk's uploaded media. The code and the
# PostgreSQL binaries are image content; nothing outside this state is written
# (except /tmp).
[[state]]
id = "listmonk"
use = "ato.state.filesystem@1"
mount = "/var/lib/listmonk"
access = "read-write"

[contract]
mode = "all"

# listmonk's unauthenticated health route (the same one its container
# HEALTHCHECK uses). Every application page either needs a listmonk session or
# starts the OIDC sign-in, so this is the stable thing to observe.
[[contract.observation]]
id = "health"
use = "ato.contract.http@1"
port = "app.http"
path = "/health"
status = 200

# listmonk and PostgreSQL in one container and one state: a portable capsule
# supports one filesystem state and a state cannot be shared by two services.
# start.sh owns PostgreSQL (loopback only) and the listmonk process.
#
# A single step, so it is not an oci_service_group: the step's image, argv,
# environment, state and Surface Port are the route's own. The Runner grants
# the oidc_issuer relay per service; the Coordinator launches a single-step
# route that declares this network Binding as a group of one service.
[[derivation]]
id = "oci-@ARCH@"
use = "ato.oci@1"
argv = ["/app/start.sh"]
cwd = "."
guest_port = 9000
env = { LISTMONK_APP_URL = "@APP_URL@", ATO_OIDC_PUBLIC_ISSUER = "@PUBLIC_ISSUER@" }
runtimes = { "oci.image" = "@APP_IMAGE@", "oci.platform" = "@PLATFORM@", "oci.entrypoint" = "/bin/sh", "oci.workspace_mount" = "/app", "oci.memory_bytes" = "1073741824", "oci.cpu_limit_millis" = "1000", "oci.pids_limit" = "256" }

[effects]
default = "pure"
