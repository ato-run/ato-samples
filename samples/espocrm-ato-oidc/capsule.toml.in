schema = "ato.capsule/2"

[application]
title = "EspoCRM"
surface_path = "/status.php"

[[input]]
id = "workspace"
use = "ato.workspace@1"
path = "."

# Ato's OpenID Provider, reached through the Runner's issuer relay. Ato launches
# a single-step OCI route that declares this network Binding as a group of one
# service, so the application container receives the relay (ato-api a250f81c7
# or later, ato Runner 68de170 or later).
[[binding]]
id = "oidc_issuer"
protocol = "ato.oidc-issuer@1"
required = true

[[binding]]
id = "oidc_client_id"
protocol = "ato.secret@1"
required = true

[[binding]]
id = "oidc_client_secret"
protocol = "ato.secret@1"
required = true

# The password of EspoCRM's database user. The database runs in the same
# container and the same state as the app; start.sh re-applies it on every
# start, so a rotated binding takes effect without touching the datadir.
[[binding]]
id = "db_password"
protocol = "ato.secret@1"
required = true

# The password of EspoCRM's administrator. The account is made by the
# installation on first start; OIDC sign-in never creates an administrator.
[[binding]]
id = "admin_password"
protocol = "ato.secret@1"
required = true

[[state]]
id = "espocrm"
use = "ato.state.filesystem@1"
mount = "/var/lib/espocrm"
access = "read-write"

[contract]
mode = "all"

# The health file in the image. EspoCRM's own pages either need a sign-in or
# start a browser redirect to Ato, so nothing in the application is a stable
# unauthenticated 200 for the contract. The file answers 200 only after
# start.sh finished installing and configuring EspoCRM.
[[contract.observation]]
id = "status"
use = "ato.contract.http@1"
port = "app.http"
path = "/status.php"
status = 200

# EspoCRM and its database in one container and one state: portable capsules
# support at most one filesystem state, and a state cannot be shared by two
# services. start.sh starts mariadbd, then Apache, and exits when either stops.
#
# A single step, so it is not an oci_service_group: the step's image, argv,
# environment, state and Surface Port are the route's own, and the Bindings
# above belong to the application. The Runner grants the oidc_issuer relay per
# service; the Coordinator launches a single-step route that declares this
# network Binding as a group of one service, so the container still gets the
# relay.
[[derivation]]
id = "oci-@ARCH@"
use = "ato.oci@1"
argv = ["/app/start.sh"]
cwd = "."
guest_port = 8080
env = { APACHE_RUN_DIR = "/tmp/apache2/run", APACHE_LOCK_DIR = "/tmp/apache2/lock", APACHE_LOG_DIR = "/tmp/apache2/log", APACHE_PID_FILE = "/tmp/apache2/run/apache2.pid", ATO_OIDC_PUBLIC_ISSUER = "@PUBLIC_ISSUER@", ESPOCRM_APP_URL = "@APP_URL@" }
runtimes = { "oci.image" = "@APP_IMAGE@", "oci.platform" = "@PLATFORM@", "oci.entrypoint" = "/bin/sh", "oci.workspace_mount" = "/app", "oci.memory_bytes" = "1073741824", "oci.cpu_limit_millis" = "1000", "oci.pids_limit" = "256" }

[effects]
default = "pure"
