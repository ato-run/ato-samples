schema = "ato.capsule/2"

[application]
title = "EspoCRM"
surface_path = "/status.php"

[[input]]
id = "workspace"
use = "ato.workspace@1"
path = "."

# Ato's OpenID Provider, reached through the Runner's issuer relay. It is
# declared as a Binding of the service below; the Runner grants the relay to
# each service of an OCI service group, which is why the one application
# container is declared as a group of one service.
[[binding]]
id = "oidc_issuer"
protocol = "ato.oidc-issuer@1"
required = true

[[binding]]
id = "oidc_client_id"
protocol = "ato.secret@1"
required = true

[[binding]]
id = "oidc_client_secret"
protocol = "ato.secret@1"
required = true

# The password of EspoCRM's database user. The database runs in the same
# container and the same state as the app; start.sh re-applies it on every
# start, so a rotated binding takes effect without touching the datadir.
[[binding]]
id = "db_password"
protocol = "ato.secret@1"
required = true

# The password of EspoCRM's administrator. The account is made by the
# installation on first start; OIDC sign-in never creates an administrator.
[[binding]]
id = "admin_password"
protocol = "ato.secret@1"
required = true

[[state]]
id = "espocrm"
use = "ato.state.filesystem@1"
mount = "/var/lib/espocrm"
access = "read-write"

[contract]
mode = "all"

# The health file in the image. EspoCRM's own pages either need a sign-in or
# start a browser redirect to Ato, so nothing in the application is a stable
# unauthenticated 200 for the contract. The file answers 200 only after
# start.sh finished installing and configuring EspoCRM.
[[contract.observation]]
id = "status"
use = "ato.contract.http@1"
port = "app.http"
path = "/status.php"
status = 200

# EspoCRM and its database in one container and one state: portable capsules
# support at most one filesystem state, and a state cannot be shared by two
# services. start.sh starts mariadbd, then Apache, and exits when either stops.
#
# The Runner grants a service the oidc_issuer relay of the Bindings it lists,
# and only a service group has services to grant it to: a single-step OCI
# route does not receive the relay, so EspoCRM could not reach the
# token/userinfo/JWKS endpoints. A service group needs 2-4 services, so the
# ESPoCRM container is accompanied by a tiny idle container from the same
# image that only holds the group open (EspoCRM itself runs the database
# in-process, as explained below).
[[derivation]]
id = "oci-@ARCH@"
use = "ato.oci@1"
runtimes = { "oci.platform" = "@PLATFORM@" }

[[derivation.service]]
id = "espocrm"
bindings = ["oidc_issuer", "oidc_client_id", "oidc_client_secret", "db_password", "admin_password"]
argv = ["/app/start.sh"]
ports = [{ id = "app.http", guest_port = 8080 }]
state = ["espocrm"]
env = { APACHE_RUN_DIR = "/tmp/apache2/run", APACHE_LOCK_DIR = "/tmp/apache2/lock", APACHE_LOG_DIR = "/tmp/apache2/log", APACHE_PID_FILE = "/tmp/apache2/run/apache2.pid", ATO_OIDC_PUBLIC_ISSUER = "@PUBLIC_ISSUER@", ESPOCRM_APP_URL = "@APP_URL@" }
runtimes = { "oci.image" = "@APP_IMAGE@", "oci.entrypoint" = "/bin/sh", "oci.workspace_mount" = "/app", "oci.memory_bytes" = "1073741824", "oci.cpu_limit_millis" = "1000", "oci.pids_limit" = "256" }

# A service group needs at least two serving services and every service must
# listen on its Port, so this second service is the same image running PHP's
# built-in web server: it accepts connections and serves nothing. It holds no
# Binding and no state. EspoCRM and its database are one process tree in the
# espocrm service above, so nothing talks to this container.
[[derivation.service]]
id = "keepalive"
argv = ["/usr/local/bin/php", "-S", "0.0.0.0:9999", "-t", "/tmp"]
ports = [{ id = "keepalive.tcp", guest_port = 9999 }]
runtimes = { "oci.image" = "@APP_IMAGE@", "oci.memory_bytes" = "33554432", "oci.cpu_limit_millis" = "50", "oci.pids_limit" = "16" }

[effects]
default = "pure"